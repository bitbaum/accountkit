{
  "name": "@bitbaum/accountkit",
  "version": "0.2.0",
  "description": "One account for every bitbaum product: the account menu, and Sign in with OrangeCat (provider, session refresh, identity rules, error screen). Styled from @bitbaum/design-tokens.",
  "license": "MIT",
  "author": "Cato",
  "homepage": "https://github.com/bitbaum/accountkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/accountkit.git"
  },
  "bugs": {
    "url": "https://github.com/bitbaum/accountkit/issues"
  },
  "keywords": [
    "account-menu",
    "avatar",
    "sign-out",
    "react",
    "headless-auth",
    "orangecat",
    "oidc",
    "next-auth",
    "auth.js"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orangecat": {
      "types": "./dist/orangecat.d.ts",
      "default": "./dist/orangecat.js"
    },
    "./styles.css": "./styles.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "check:dist": "git diff --exit-code --stat -- dist",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test && pnpm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "esbuild demo/demo.tsx --bundle --jsx=automatic --format=iife --define:process.env.NODE_ENV='\"production\"' --outfile=demo/dist/demo.js --log-level=warning",
    "test:browser": "pnpm run demo && node test/browser.mjs"
  },
  "devDependencies": {
    "@bitbaum/design-tokens": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
