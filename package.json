{
  "name": "@bitbaum/accountkit",
  "version": "0.8.0",
  "description": "One account for every bitbaum product: the account menu, accounts themselves (better-auth: password, magic link, passkeys, 2FA, OIDC) and Sign in with OrangeCat. Styled from @bitbaum/design-tokens.",
  "license": "MIT",
  "author": "Cato",
  "homepage": "https://github.com/bitbaum/accountkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/accountkit.git"
  },
  "bugs": {
    "url": "https://github.com/bitbaum/accountkit/issues"
  },
  "keywords": [
    "account-menu",
    "avatar",
    "sign-out",
    "react",
    "headless-auth",
    "orangecat",
    "oidc",
    "next-auth",
    "auth.js"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orangecat": {
      "types": "./dist/orangecat.d.ts",
      "default": "./dist/orangecat.js"
    },
    "./styles.css": "./styles.css",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/schema": {
      "types": "./dist/auth/schema.d.ts",
      "default": "./dist/auth/schema.js"
    },
    "./auth/server": {
      "types": "./dist/auth/server.d.ts",
      "default": "./dist/auth/server.js"
    },
    "./auth/next": {
      "types": "./dist/auth/next.d.ts",
      "default": "./dist/auth/next.js"
    },
    "./auth/client": {
      "types": "./dist/auth/client.d.ts",
      "default": "./dist/auth/client.js"
    },
    "./auth/react": {
      "types": "./dist/auth/react.d.ts",
      "default": "./dist/auth/react.js"
    },
    "./auth/mail": {
      "types": "./dist/auth/mail.d.ts",
      "default": "./dist/auth/mail.js"
    }
  },
  "peerDependencies": {
    "@better-auth/passkey": "^1.7.10",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "react": ">=18",
    "@bitbaum/mail-kit": "^0.2.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json",
    "test": "node --test test/*.test.js",
    "check:dist": "git diff --exit-code --stat -- dist",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test && pnpm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "esbuild demo/demo.tsx --bundle --jsx=automatic --format=iife --define:process.env.NODE_ENV='\"production\"' --outfile=demo/dist/demo.js --log-level=warning",
    "test:browser": "pnpm run demo && node test/browser.mjs"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@better-auth/passkey": "^1.7.10",
    "@bitbaum/design-tokens": "^1.2.0",
    "@bitbaum/mail-kit": "0.2.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "better-auth": "^1.7.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@better-auth/passkey": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@bitbaum/mail-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "limitkit": "^0.2.0"
  }
}
